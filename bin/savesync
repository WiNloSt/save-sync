#!/usr/bin/python3
"""savesync — Steam-Cloud-style saves for non-Steam games (host side).

Heroic runs a global Before/After launch hook for every game; the hook calls
`savesync hook before|after …` on the host. Phase 1: versioned local backups
on exit via Ludusavi. Cloud sync comes later (docs/PLAN.md).

  savesync list                      games, their save folders, confirmed or not
  savesync paths <game> [--set P… | --add P | --detect]
                                     show / repick a game's save folders
  savesync backup [<game>…]          back up now (default: all)
  savesync sync [--pending] [<game>…]  sync now / push what was saved while offline
  savesync resolve <game> cloud|local  settle a save conflict without the popup
  savesync history <game> [-n N]     who pushed / pulled / hit a conflict, from the cloud log
  savesync login [--force]           sign this device in (Google, once; skipped if already valid)
  savesync status                    is this device signed in?
  savesync update                    install the latest version now (also checked at every launch)
  savesync devices [--revoke <id>]   signed-in devices; sign one out
  savesync setup-heroic              set Heroic's global hooks (Heroic must be closed)
  savesync gen-config                rewrite the Ludusavi config from the registry
  savesync doctor                    check everything is wired up
  savesync hook before|after <app> <title> <exec> <runner> <prefix>   (Heroic calls this)

<game> is the Heroic app name (see `savesync list`) or the title.
"""
import glob
import hashlib
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import secrets
import threading
import time
import urllib.error
import urllib.request
import webbrowser
from pathlib import Path

HOME = Path.home()
APP_HOME = HOME / ".local/share/save-sync"
CFG_HOME = HOME / ".config/save-sync"
REGISTRY = CFG_HOME / "games.json"
STATE = APP_HOME / "state"
LUDUSAVI_CFG = CFG_HOME / "ludusavi"
BACKUPS = APP_HOME / "backups"
LOG = APP_HOME / "logs/savesync.log"
LUDUSAVI = APP_HOME / "bin/ludusavi"
RENPY_HOME = HOME / ".renpy"
HEROIC_APP = "com.heroicgameslauncher.hgl"
HEROIC_HOME = HOME / f".var/app/{HEROIC_APP}"      # sandbox HOME for anything not granted
HEROIC_CFG = HEROIC_HOME / "config/heroic"
HEROIC_CONFIG = HEROIC_CFG / "config.json"
HEROIC_LIBRARY = HEROIC_CFG / "sideload_apps/library.json"
HEROIC_GAMESCONFIG = HEROIC_CFG / "GamesConfig"
HOOK_DIR = HOME / "Games/Heroic/save-sync"          # inside Heroic's sandbox grant
HOOK = HOOK_DIR / "hook.sh"
TOKENS_GAME = "Ren'Py security tokens"
RETENTION_FULL = 5
RCLONE = APP_HOME / "bin/rclone"
SETTINGS = CFG_HOME / "settings.json"
CONFLICTS = APP_HOME / "conflicts"
DEVICE = os.environ.get("SAVESYNC_DEVICE") or socket.gethostname()
SESSION = CFG_HOME / "session"       # the device's remembered login (0600)

# First-play detection: where games write, and what to ignore there.
WATCH_ROOTS = [RENPY_HOME, HOME / ".config", HOME / ".local/share", HEROIC_HOME]
WATCH_SKIP = {
    "Steam", "flatpak", "Trash", "baloo", "save-sync", "waydroid", "waydroid-images",
    "containers", "kactivitymanagerd", "recently-used.xbel", "pulse", "dconf",
    "fontconfig", "mesa_shader_cache", "Cache", "GPUCache", "Code Cache", "Crashpad",
    "cache", "heroic", "Heroic", "plasma", "kwin", "klipper", "akonadi",
    "pnpm", "podman-compose-venv", "Claude", ".wrangler", "node_modules", ".git",
}
NOISE = re.compile(r"(\.log|\.tmp|\.lock|\.pid|cache|shader|crash|\.old)$|/(logs?|cache|tmp)/", re.I)
WATCH_DEPTH = 5


# ---------------------------------------------------------------- helpers
def log(msg):
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as f:
        f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}\n")


def say(msg):
    print(msg)
    log(msg)


def notify(summary, body=""):
    log(f"notify: {summary} | {body}")
    if os.environ.get("SAVESYNC_NO_NOTIFY") == "1":
        return
    try:
        subprocess.run(["notify-send", "-a", "save-sync", summary, body], timeout=5)
    except Exception:
        pass


def load_json(path, default):
    try:
        return json.loads(Path(path).read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return default


def save_json(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    tmp.replace(path)


def registry():
    return load_json(REGISTRY, {})


def find_game(reg, key):
    if key in reg:
        return key
    for app, g in reg.items():
        if g["title"].lower() == key.lower():
            return app
    raise SystemExit(f"unknown game: {key}  (see: savesync list)")


def ludusavi_glob_escape(s):
    # Ludusavi paths are globs; special chars are escaped as [x]
    return re.sub(r"([\[\]*?{}])", r"[\1]", s)


def to_ludusavi_path(p):
    p = str(p)
    home = str(HOME)
    if p == home or p.startswith(home + "/"):
        return "<home>" + ludusavi_glob_escape(p[len(home):])
    return ludusavi_glob_escape(p)


def ludusavi(*args, capture=True):
    cmd = [str(LUDUSAVI), "--config", str(LUDUSAVI_CFG), "--no-manifest-update", *args]
    return subprocess.run(cmd, capture_output=capture, text=True)


# ------------------------------------------------------------ engine rules
def is_renpy(d):
    return d is not None and (d / "renpy").is_dir() and (d / "game").is_dir()


def match_renpy_dir(game_dir):
    """~/.renpy/<save_directory> by identical save contents.

    <save_directory> is compiled into the game and often unrelated to its
    name (one game uses Ren'Py's default `Testgame-<id>`), so names can't be trusted."""
    saves = game_dir / "game/saves"
    if not saves.is_dir() or not RENPY_HOME.is_dir():
        return None
    best, best_n = None, 0
    for cand in RENPY_HOME.iterdir():
        if not cand.is_dir() or cand.name == "tokens":
            continue
        n = 0
        for f in saves.iterdir():
            other = cand / f.name
            if f.suffix == ".save" and other.is_file() and other.stat().st_size == f.stat().st_size \
                    and other.read_bytes() == f.read_bytes():
                n += 1
        if n > best_n:
            best, best_n = cand.name, n
    return best


def rule_paths(g):
    """Save folders we can name without watching a play session."""
    d = Path(g["game_dir"]) if g.get("game_dir") else None
    if is_renpy(d):
        g["engine"] = "renpy"
        # game/saves is the copy Ren'Py keeps complete; ~/.renpy/<dir> lags far
        # behind and would double every backup. Use ~/.renpy only for a game
        # whose game/saves has no saves (e.g. a read-only install).
        saves = d / "game/saves"
        rd = g.get("renpy_dir") or match_renpy_dir(d)
        if rd:
            g["renpy_dir"] = rd
        if saves.is_dir() and any(saves.glob("*.save")):
            return [str(saves)]
        if rd and any((RENPY_HOME / rd).glob("*.save")):
            return [str(RENPY_HOME / rd)]
        return [str(saves)]
    return []


# ------------------------------------------------------------ first-play watch
def walk_mtimes(roots, extra=()):
    out = {}
    for root in [*roots, *extra]:
        root = Path(root)
        if not root.is_dir():
            continue
        base_depth = len(root.parts)
        for dirpath, dirnames, filenames in os.walk(root):
            depth = len(Path(dirpath).parts) - base_depth
            dirnames[:] = [n for n in dirnames if n not in WATCH_SKIP and depth < WATCH_DEPTH]
            for fn in filenames:
                p = os.path.join(dirpath, fn)
                try:
                    out[p] = os.stat(p).st_mtime
                except OSError:
                    pass
    return out


def watch_roots_for(g):
    extra = []
    if g.get("game_dir"):
        extra.append(g["game_dir"])
    windows = g.get("runner") != "sideload" or g.get("exec", "").lower().endswith(".exe")
    if windows and g.get("prefix"):
        users = Path(g["prefix"]) / "drive_c/users"
        if users.is_dir():
            extra.append(str(users))
    return extra


MAX_SUGGEST_BYTES = 300 * 1024 * 1024
MAX_SUGGEST_FILES = 3000


def dir_size(d):
    n = size = 0
    for f in Path(d).rglob("*"):
        if f.is_file():
            n += 1
            size += f.stat().st_size
            if n > MAX_SUGGEST_FILES or size > MAX_SUGGEST_BYTES:
                break
    return n, size


def changed_dirs(before, after, started, roots, game_dir=None):
    """Folders a play session wrote to, as SUGGESTIONS (never backed up
    until confirmed). Never a watch root, HOME, or the game's own root: other
    apps write to ~/.config during play, and games write logs next to their
    binary (2026-09-27: ~/.config and the whole game folder were picked)."""
    forbidden = {str(HOME)} | {str(Path(r)) for r in roots}
    if game_dir:
        forbidden.add(str(Path(game_dir)))
    counts = {}
    for p, m in after.items():
        rel = p[len(str(HOME)):] if p.startswith(str(HOME) + "/") else p
        if m < started or before.get(p) == m or NOISE.search(rel):
            continue
        d = os.path.dirname(p)
        if d in forbidden or any(d == f for f in forbidden):
            continue                   # a file directly in a root: not evidence of a save dir
        counts[d] = counts.get(d, 0) + 1
    keep = []
    for d in sorted(counts, key=len):  # collapse children into an already-kept parent
        if not any(d.startswith(k + "/") for k in keep):
            keep.append(d)
    out = []
    for d in keep:
        if any(d == f for f in forbidden):
            continue
        n, size = dir_size(d)
        if n > MAX_SUGGEST_FILES or size > MAX_SUGGEST_BYTES:
            log(f"detection: ignored {d} (too big to be a save folder: {n}+ files, {size >> 20}+ MB)")
            continue
        out.append(d)
    return out[:5]


# ------------------------------------------------------------ Ludusavi config
def custom_games(reg):
    out = []
    for g in reg.values():
        if g.get("save_paths"):
            out.append({"name": g["title"], "integration": "override",
                        "files": [to_ludusavi_path(p) for p in g["save_paths"]]})
    out.append({"name": TOKENS_GAME, "integration": "override", "files": ["<home>/.renpy/tokens"]})
    return out


def cmd_gen_config(_args=None, quiet=False, redirects=()):
    cfg = {
        "manifest": {"enable": False},  # only our own custom games
        "release": {"check": False},
        "roots": [],
        "backup": {
            "path": str(BACKUPS),
            "retention": {"full": RETENTION_FULL, "differential": 0},
            "format": {"chosen": "zip", "zip": {"compression": "zstd"}},
        },
        "restore": {"path": str(BACKUPS)},
        "cloud": {"remote": None, "path": "save-sync", "synchronize": False},
        "customGames": custom_games(registry()),
        "redirects": list(redirects),
    }
    LUDUSAVI_CFG.mkdir(parents=True, exist_ok=True)
    # JSON is valid YAML; Ludusavi fills every omitted key with its default.
    save_json(LUDUSAVI_CFG / "config.yaml", cfg)
    r = ludusavi("config", "show")
    if r.returncode != 0:
        raise SystemExit(f"Ludusavi rejected the generated config:\n{r.stderr}")
    if not quiet:
        say(f"  wrote {LUDUSAVI_CFG / 'config.yaml'} ({len(cfg['customGames'])} custom games)")


def has_files(paths):
    for p in paths:
        p = Path(p)
        if p.is_file() or (p.is_dir() and any(f.is_file() for f in p.rglob("*"))):
            return True
    return False


def ensure_config():
    cfg = LUDUSAVI_CFG / "config.yaml"
    if not cfg.exists() or (REGISTRY.exists() and REGISTRY.stat().st_mtime > cfg.stat().st_mtime):
        cmd_gen_config(quiet=True)


def backup(titles):
    """Back up the named games (plus Ren'Py's device keys if present).

    Ludusavi errors with "No info" for a game with no files yet, so those are
    skipped: a brand-new game with no saves isn't a failure."""
    ensure_config()
    reg = registry().values()
    wanted = [t for t in titles
              if has_files(next((g.get("save_paths", []) for g in reg if g["title"] == t), []))]
    if (RENPY_HOME / "tokens").is_dir():
        wanted.append(TOKENS_GAME)
    if not wanted:
        return subprocess.CompletedProcess([], 0, "nothing to back up yet", "")
    r = ludusavi("backup", "--force", *wanted)
    if r.returncode != 0:
        log(f"backup failed: {r.stderr.strip()}")
    return r



# ------------------------------------------------------------ cloud sync
# Cloud layout (per game, by title):
#   games/<title>/            mirror of the pushing device's Ludusavi backup dir
#   games/<title>.head.json   {fp, parent, device, time, save_time, session_start,
#                             game_dir}: what the cloud holds, and what it was built on
#   events/<title>/<utc>-<device>-<kind>.json   one object per push / pull / conflict
#                             (`savesync history`). Outside games/<title>/, which push
#                             mirrors with `rclone sync`.
# Local: state/<title>.base.json = the fp both sides agreed on at the last sync;
#        state/<title>.session.json = when this device's last play session started,
#        and from which save (a device can sit asleep mid-game for days).
# The glue owns direction (3-way: base / local / cloud); Ludusavi only makes and
# restores backups.

class Offline(Exception):
    pass


def settings():
    return load_json(SETTINGS, {})


def cloud_env():
    """rclone remote `ss:` defined purely by env vars, never written to disk."""
    c = settings().get("cloud") or {}
    if os.environ.get("SAVESYNC_OFFLINE") == "1":
        raise Offline("SAVESYNC_OFFLINE=1")
    mode = c.get("mode")
    if mode == "local":                      # stand-in cloud for tests
        return {"RCLONE_CONFIG_SS_TYPE": "alias", "RCLONE_CONFIG_SS_REMOTE": c["path"]}
    if mode == "worker":
        return worker_cloud_env(c)
    return None                              # cloud not configured: local backups only


class SignedOut(Exception):
    pass


def worker_call(url, method="GET", body=None, token=None, timeout=15):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method,
                                 headers={"content-type": "application/json",
                                          "user-agent": "save-sync"})
    if token:
        req.add_header("authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        if e.code == 401:
            raise SignedOut("session expired or revoked")
        try:
            return {"_status": e.code, **json.loads(e.read() or b"{}")}
        except Exception:
            raise Offline(f"worker HTTP {e.code}")
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        raise Offline(f"worker unreachable: {e}")


def obscure(secret):
    r = subprocess.run([str(RCLONE), "obscure", "-"], input=secret, capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError("rclone obscure failed")
    return r.stdout.strip()


def worker_cloud_env(c):
    """Fetch the R2 key + crypt key for this sync. Held in memory only."""
    if not SESSION.exists():
        notify("save-sync: not signed in", "Run: savesync login (in Desktop Mode)")
        raise Offline("not signed in")
    try:
        k = worker_call(c["url"].rstrip("/") + "/keys", "POST", {}, SESSION.read_text().strip())
    except SignedOut:
        notify("save-sync: signed out", "Sign in again in Desktop Mode: savesync login")
        raise Offline("signed out")
    r2, cr = k["r2"], k["crypt"]
    return {
        "RCLONE_CONFIG_R2_TYPE": "s3", "RCLONE_CONFIG_R2_PROVIDER": "Cloudflare",
        "RCLONE_CONFIG_R2_ACCESS_KEY_ID": r2["access_key_id"],
        "RCLONE_CONFIG_R2_SECRET_ACCESS_KEY": r2["secret_access_key"],
        "RCLONE_CONFIG_R2_ENDPOINT": r2["endpoint"],
        "RCLONE_CONFIG_R2_NO_CHECK_BUCKET": "true",
        "RCLONE_CONFIG_SS_TYPE": "crypt",
        "RCLONE_CONFIG_SS_REMOTE": f"r2:{r2['bucket']}",
        "RCLONE_CONFIG_SS_PASSWORD": obscure(cr["password"]),
        "RCLONE_CONFIG_SS_PASSWORD2": obscure(cr["salt"]),
    }


def session_status():
    """'valid' | 'invalid' | 'missing' | 'unknown' (Worker unreachable)."""
    c = settings().get("cloud") or {}
    if not SESSION.exists() or not SESSION.read_text().strip():
        return "missing"
    try:
        worker_call(c["url"].rstrip("/") + "/devices", token=SESSION.read_text().strip())
        return "valid"
    except SignedOut:
        return "invalid"
    except Offline:
        return "unknown"


def cmd_status(_args=None):
    st = session_status()
    say({"valid": f"signed in ({DEVICE})", "invalid": "signed out (session expired or revoked): savesync login",
         "missing": "not signed in: savesync login",
         "unknown": "can't reach the Worker right now; keeping the existing sign-in"}[st])
    return st


def cmd_login(args=None):
    c = settings().get("cloud") or {}
    if c.get("mode") != "worker":
        raise SystemExit("cloud isn't configured on this device (settings.json has no worker url)")
    if "--force" not in (args or []):
        st = session_status()
        if st == "valid":
            say(f"Already signed in ({DEVICE}). Use --force to sign in again.")
            return
        if st == "unknown":
            say("Can't reach the Worker to check the existing sign-in; keeping it. Try again when online.")
            return
        if st == "invalid":
            SESSION.unlink(missing_ok=True)
            say("The saved sign-in expired or was revoked; signing in again.")
    base = c["url"].rstrip("/")
    p = secrets.token_urlsafe(32)
    h = hashlib.sha256(p.encode()).hexdigest()
    url = f"{base}/auth/start?h={h}&device={urllib.request.quote(DEVICE)}"
    say(f"Opening your browser to sign in with Google…\nIf it doesn't open, visit:\n  {url}")
    try:
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        webbrowser.open(url)
    deadline = time.time() + 600
    while time.time() < deadline:
        time.sleep(2)
        try:
            r = worker_call(base + "/auth/poll", "POST", {"p": p})
        except Offline as e:
            say(f"  (waiting: {e})")
            continue
        state = r.get("state")
        if state == "done":
            CFG_HOME.mkdir(parents=True, exist_ok=True)
            fd = os.open(SESSION, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write(r["token"])
            say(f"Signed in. {DEVICE} will sync on every game launch and exit.")
            return
        if state in ("denied", "expired"):
            raise SystemExit(f"Sign-in {state}.")
    raise SystemExit("Timed out waiting for sign-in (10 min).")


def cmd_devices(args):
    c = settings().get("cloud") or {}
    base = c["url"].rstrip("/")
    tok = SESSION.read_text().strip()
    if args[:1] == ["--revoke"] and len(args) == 2:
        say(json.dumps(worker_call(f"{base}/devices?id={args[1]}", "DELETE", token=tok)))
        return
    for d in worker_call(base + "/devices", token=tok).get("devices", []):
        seen = time.strftime("%Y-%m-%d", time.localtime(d.get("touched", 0)))
        say(f"  {d['id']}  {d.get('device', '?'):<20} last used {seen}{'  (this device)' if d.get('this') else ''}")


def rclone(env, *args, check=True):
    # --s3-disable-http2 / --multi-thread-streams 0: downloads from R2 over
    # HTTP/2 stalled at random offsets (12.9 MB: stuck >5 min; fixed: 0.4 s).
    cmd = [str(RCLONE), "--config", "/dev/null", "--s3-disable-http2", "--multi-thread-streams", "0",
           "--contimeout", "5s", "--timeout", "20s", "--retries", "2",
           "--low-level-retries", "2", "--transfers", "8", "--checkers", "16", *args]
    r = subprocess.run(cmd, env={**os.environ, **env}, capture_output=True, text=True)
    if check and r.returncode != 0:
        msg = r.stderr.strip().splitlines()[-1:] or [""]
        raise Offline(msg[0])
    return r


def cloud_head(env, title):
    r = rclone(env, "cat", f"ss:games/{title}.head.json", check=False)
    if r.returncode == 0:
        # on S3/R2 a missing object gives exit 0 and no output
        return json.loads(r.stdout) if r.stdout.strip() else None
    if "not found" in r.stderr.lower() or "doesn't exist" in r.stderr.lower() \
            or "no such file" in r.stderr.lower():
        return None
    raise Offline((r.stderr.strip().splitlines() or ["rclone error"])[-1])


def put_head(env, title, head):
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = STATE / f"{title}.head.upload.json"
    tmp.write_text(json.dumps(head))
    rclone(env, "copyto", str(tmp), f"ss:games/{title}.head.json")
    tmp.unlink(missing_ok=True)


def fingerprint(paths):
    """Content hash of the live saves. Keyed by (which save folder, path inside
    it), so the same saves hash the same on devices whose game folders are named
    differently (SpiderMan-1.0-pc on the PC, spiderman on the Deck)."""
    h = hashlib.sha256()
    n = 0
    for i, root in enumerate(paths):
        root = Path(root)
        files = [root] if root.is_file() else (sorted(f for f in root.rglob("*") if f.is_file())
                                               if root.is_dir() else [])
        for f in files:
            rel = f.name if f == root else str(f.relative_to(root))
            h.update(f"{i}:{rel}".encode() + b"\0" + hashlib.sha256(f.read_bytes()).digest())
            n += 1
    return h.hexdigest() if n else "empty"


def base_file(title):
    return STATE / f"{title}.base.json"


def get_base(title):
    return load_json(base_file(title), {}).get("fp")


def set_base(title, fp):
    save_json(base_file(title), {"fp": fp, "time": time.time(), "device": DEVICE})


def pending_file(title):
    STATE.mkdir(parents=True, exist_ok=True)   # fresh device: nothing has created it yet
    return STATE / f"{title}.pending"


def session_file(title):
    return STATE / f"{title}.session.json"


def get_session(title):
    return load_json(session_file(title), {})


def start_session(g):
    STATE.mkdir(parents=True, exist_ok=True)
    save_json(session_file(g["title"]), {"start": time.time(), "fp": fingerprint(g["save_paths"]),
                                         "parent": get_base(g["title"]), "device": DEVICE})


def code_version():
    return (SRC / ".commit").read_text().strip()[:7] if (SRC / ".commit").exists() else "dev"


def cloud_event(env, title, kind, **fields):
    """Add one entry to the cloud's log for this game (one object per event: S3
    has no append, and two devices never write the same name). Best-effort: a
    failed log write never fails a sync."""
    t = time.time()
    name = f"{time.strftime('%Y%m%dT%H%M%S', time.gmtime(t))}.{int(t * 1000) % 1000:03d}Z-{DEVICE}-{kind}.json"
    tmp = STATE / f"{title}.event.json"
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        tmp.write_text(json.dumps({"kind": kind, "device": DEVICE, "time": t,
                                   "version": code_version(), **fields}))
        rclone(env, "copyto", str(tmp), f"ss:events/{title}/{name}")
    except Exception as e:
        log(f"sync {title}: cloud event log failed ({e!r})")
    finally:
        tmp.unlink(missing_ok=True)


def backup_dir(title):
    return BACKUPS / title


def quarantine(title, g, why, env=None):
    """Keep the losing side before anything is overwritten: this device's live
    saves + backups, and (when this device wins) the cloud's backups too."""
    dest = CONFLICTS / title / time.strftime("%Y%m%d-%H%M%S")
    dest.mkdir(parents=True, exist_ok=True)
    for i, p in enumerate(g.get("save_paths", [])):
        if Path(p).exists():
            target = dest / f"live-{i}-{Path(p).name}"
            if Path(p).is_dir():
                shutil.copytree(p, target)
            else:
                shutil.copy2(p, target)
    if backup_dir(title).is_dir():
        shutil.copytree(backup_dir(title), dest / "backups")
    if env is not None:
        rclone(env, "copy", f"ss:games/{title}", str(dest / "cloud-backups"))
        rclone(env, "copyto", f"ss:games/{title}.head.json", str(dest / "cloud-head.json"), check=False)
    (dest / "WHY.txt").write_text(f"{why}\nsave paths: {g.get('save_paths')}\n")
    log(f"sync {title}: quarantined both sides' local copy to {dest}")
    return dest


def split_mapping(text):
    """Ludusavi mapping.yaml -> (header, [backup entry blocks]) (full backups only)."""
    parts = re.split(r"(?m)^(?=  - name: )", text)
    return parts[0], parts[1:]


def entry_name(block):
    return re.match(r"  - name: (.+)", block).group(1).strip().strip('"')


def pull(env, title, g, head, why, local_fp):
    """Cloud -> local backups -> live saves. Downloads only the cloud's newest
    backup and appends it to this device's own history (a fresh device used to
    fetch the whole history: 192 MB for 13 MB of saves). Ludusavi trims the
    history back to RETENTION_FULL on the next backup."""
    bdir = backup_dir(title)
    bdir.mkdir(parents=True, exist_ok=True)
    cloud_header, cloud_entries = split_mapping(
        rclone(env, "cat", f"ss:games/{title}/mapping.yaml").stdout)
    if not cloud_entries:
        raise RuntimeError("cloud backup has no entries")
    newest = cloud_entries[-1]
    latest = entry_name(newest)
    if not (bdir / latest).exists():
        rclone(env, "copyto", f"ss:games/{title}/{latest}", str(bdir / latest))
    local_map = bdir / "mapping.yaml"
    if local_map.exists():
        header, entries = split_mapping(local_map.read_text())
        entries = [e for e in entries if (bdir / entry_name(e)).exists() and entry_name(e) != latest]
    else:
        header, entries = cloud_header, []
    local_map.write_text(header + "".join(entries) + newest)
    redirects = []
    old, new = head.get("game_dir"), g.get("game_dir")
    if old and new and old != new:
        # the other device has the game in a different (version) folder
        redirects.append({"kind": "restore", "source": old, "target": new})
    cmd_gen_config(quiet=True, redirects=redirects)
    r = ludusavi("restore", "--force", "--no-cloud-sync", title)
    if redirects:
        cmd_gen_config(quiet=True)
    if r.returncode != 0:
        raise RuntimeError(f"restore failed: {r.stderr.strip()}")
    log(f"sync {title}: pulled from cloud (pushed by {head.get('device')} at "
        f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(head.get('time', 0)))}; {why})")
    cloud_event(env, title, "pull", why=why, fp=head.get("fp"), from_device=head.get("device"),
                pushed=head.get("time"), replaced=local_fp)


def push(env, title, g, fp, why, replaced=None):
    """`replaced`: the cloud fp this overwrites (None: nothing / unknown)."""
    bdir = backup_dir(title)
    if not bdir.is_dir():
        return
    rclone(env, "sync", str(bdir), f"ss:games/{title}")
    head = {"fp": fp, "parent": get_base(title), "device": DEVICE, "time": time.time(),
            "save_time": newest_local_mtime(g), "session_start": get_session(title).get("start"),
            "game_dir": g.get("game_dir")}
    put_head(env, title, head)
    log(f"sync {title}: pushed to cloud ({why})")
    cloud_event(env, title, "push", why=why, replaced=replaced,
                **{k: head[k] for k in ("fp", "parent", "save_time", "session_start")})


def newest_local_mtime(g):
    """When the saves were last written. Skips Ren'Py's `persistent`, which the
    game rewrites on every quit (even after days asleep without playing)."""
    m = 0
    for p in g.get("save_paths", []):
        p = Path(p)
        files = [p] if p.is_file() else (list(p.rglob("*")) if p.is_dir() else [])
        m = max([m] + [f.stat().st_mtime for f in files if f.is_file() and f.name != "persistent"])
    return m


def gamescope_target():
    """(DISPLAY, Steam app id) when Heroic runs in Game Mode, else None.

    There Heroic is a Steam shortcut started as `reaper SteamLaunch AppId=N …
    com.heroicgameslauncher.hgl`. gamescope only shows windows it can tie to the
    focused app, which it does by walking a window's process tree up to that
    reaper. Our dialog runs on the host (flatpak-spawn): outside that tree and
    with no DISPLAY, so kdialog aborted and the conflict silently became 'later'.
    Borrow the reaper's DISPLAY and tag the window STEAM_GAME=N instead."""
    for p in Path("/proc").iterdir():
        if not p.name.isdigit():
            continue
        try:
            argv = (p / "cmdline").read_bytes().decode(errors="replace").split("\0")
            if not argv[0].endswith("/reaper") or not any(HEROIC_APP in a for a in argv):
                continue
            appid = next((a[len("AppId="):] for a in argv if a.startswith("AppId=")), None)
            env = dict(kv.split("=", 1) for kv in
                       (p / "environ").read_bytes().decode(errors="replace").split("\0") if "=" in kv)
        except OSError:
            continue
        if appid and env.get("DISPLAY"):
            return env["DISPLAY"], appid
    return None


def tag_for_gamescope(proc, display, appid):
    """Mark the dialog's windows as part of Heroic's Steam app so gamescope shows them."""
    env = {**os.environ, "DISPLAY": display}
    tagged = set()
    try:
        while proc.poll() is None:
            r = subprocess.run(["xdotool", "search", "--pid", str(proc.pid)],
                               env=env, capture_output=True, text=True)
            for w in set(r.stdout.split()) - tagged:
                subprocess.run(["xprop", "-id", w, "-f", "STEAM_GAME", "32c", "-set", "STEAM_GAME", appid],
                               env=env, capture_output=True)
                tagged.add(w)
            time.sleep(0.3)
    except OSError as e:
        log(f"dialog: can't tag the window for Game Mode ({e})")


def gamepad_to_keys(proc, display):
    """kdialog can't read a controller, and in Game Mode there's no keyboard. Steam
    keeps feeding its virtual Xbox pad (/dev/input/js*, readable by the seat user)
    while our window is focused, so translate it: d-pad / left stick = previous /
    next button, A = press, B = Escape ('Decide later')."""
    import struct, select
    fds = []
    for path in glob.glob("/dev/input/js*"):
        try:
            fds.append(os.open(path, os.O_RDONLY | os.O_NONBLOCK))
        except OSError:
            pass
    if not fds:
        log("dialog: no readable gamepad (/dev/input/js*); touch / trackpad only")
        return
    env = {**os.environ, "DISPLAY": display}
    key = lambda k: subprocess.run(["xdotool", "key", k], env=env, capture_output=True)
    held = {}                                   # axis -> direction, until it recentres
    try:
        while proc.poll() is None:
            for fd in select.select(fds, [], [], 0.3)[0]:
                while True:
                    try:
                        _, value, kind, num = struct.unpack("IhBB", os.read(fd, 8))
                    except (BlockingIOError, struct.error):
                        break
                    if kind & 0x80:                 # initial state, not a press
                        continue
                    if kind == 1 and value == 1:   # button down: 0 = A, 1 = B
                        {0: lambda: key("space"), 1: lambda: key("Escape")}.get(num, lambda: None)()
                    elif kind == 2 and num in (0, 1, 6, 7):   # stick x/y, d-pad x/y
                        d = 1 if value > 16000 else -1 if value < -16000 else 0
                        if abs(value) < 8000:
                            held.pop(num, None)
                        elif d and held.get(num) != d:
                            held[num] = d
                            # arrows, not Tab: Shift+Tab is Steam's overlay shortcut
                            key("Right" if d > 0 else "Left")
    except OSError as e:
        log(f"dialog: gamepad input stopped ({e})")
    finally:
        for fd in fds:
            os.close(fd)


def run_dialog(args, timeout=600, gs=None):
    """kdialog's exit code (0/1/2 = the three buttons), "timeout", or None when no
    dialog could be shown (no display: kdialog aborts, rc < 0). gs: gamescope_target()."""
    env = dict(os.environ)
    if gs:
        env.update(DISPLAY=gs[0], QT_QPA_PLATFORM="xcb")
        env.pop("WAYLAND_DISPLAY", None)
    try:
        p = subprocess.Popen(["kdialog", *args], env=env, text=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    except OSError as e:
        log(f"dialog: can't run kdialog ({e})")
        return None
    if gs:
        threading.Thread(target=tag_for_gamescope, args=(p, *gs), daemon=True).start()
        threading.Thread(target=gamepad_to_keys, args=(p, gs[0]), daemon=True).start()
    try:
        _, err = p.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        p.kill()
        p.communicate()
        return "timeout"
    if p.returncode not in (0, 1, 2):
        log(f"dialog: kdialog failed (rc {p.returncode}, {'Game Mode' if gs else 'desktop'}): "
            f"{(err.strip().splitlines() or ['no output'])[0]}")
        return None
    return p.returncode


def ask_conflict(title, head, local_fp, g=None):
    """Steam-style prompt -> (choice, how). choice: 'cloud' | 'local' | 'later';
    how: 'user' | 'forced' | 'timeout' | 'unavailable'. With no answer it is
    'later' (play this device's save, upload nothing, ask again next launch),
    never a guess: a device left asleep mid-game has the newest file times."""
    forced = os.environ.get("SAVESYNC_CONFLICT_CHOICE")
    if forced:
        return forced, "forced"
    fmt = lambda t: time.strftime("%a %d %b, %H:%M", time.localtime(t)) if t else "unknown"
    since = lambda t: f"\n      (session started {fmt(t)})" if t else ""
    cloud_t = head.get("save_time") or head.get("time", 0)   # when it was saved, not uploaded
    gs = gamescope_target()
    text = (f"{title}: the cloud and this device both have saves the other hasn't seen.\n\n"
            f"Cloud:  last save {fmt(cloud_t)} on {head.get('device', '?')}"
            f"{since(head.get('session_start'))}\n"
            f"This device:  last save {fmt(newest_local_mtime(g or {}))} on {DEVICE}"
            f"{since(get_session(title).get('start'))}\n\n"
            f"Whichever you don't pick is kept in\n~/.local/share/save-sync/conflicts/\n"
            f"'Decide later' plays this device's save, uploads nothing, and asks again next launch."
            + ("\n\nController: D-pad to pick, A to confirm, B = Decide later." if gs else ""))
    rc = run_dialog(["--title", f"save-sync: {title}", "--warningyesnocancel", text,
                     "--yes-label", "Use cloud save", "--no-label", "Use this device's save",
                     "--cancel-label", "Decide later"], gs=gs)
    if rc in (0, 1, 2):
        return ("cloud", "local", "later")[rc], "user"
    notify(f"{title}: save conflict, not resolved",
           f"Playing this device's save; nothing uploaded. Resolve: savesync resolve '{title}' cloud|local")
    return "later", "timeout" if rc == "timeout" else "unavailable"


def record_conflict(env, title, when, choice, how, base, local_fp, head, g):
    """Log + cloud event; keep the losing side (both, locally) unless deferred."""
    log(f"sync {title}: conflict {when} (base={str(base)[:8]} local={local_fp[:8]} "
        f"cloud={head['fp'][:8]} from {head.get('device')}) -> {choice} ({how})")
    dest = None
    if choice != "later":
        dest = quarantine(title, g, f"conflict {when}; chose {choice} ({how})",
                          env if choice == "local" else None)
    cloud_event(env, title, "conflict", when=when, choice=choice, how=how, base=base,
                local_fp=local_fp, local_session_start=get_session(title).get("start"),
                cloud_fp=head["fp"], cloud_device=head.get("device"),
                cloud_session_start=head.get("session_start"),
                quarantine=str(dest) if dest else None)


def sync_before(g):
    """Before the game starts: make the live saves the newest agreed state."""
    title = g["title"]
    if not g.get("save_paths"):
        return
    try:
        env = cloud_env()
        if env is None:
            return
        head = cloud_head(env, title)
    except Offline as e:
        notify(f"{title}: offline, playing with this device's saves", "It will sync when you're back online.")
        log(f"sync {title}: offline before launch ({e})")
        return
    local_fp = fingerprint(g["save_paths"])
    base = get_base(title)
    if head is None:
        return                                 # nothing in the cloud yet; the exit pushes
    cloud_fp = head["fp"]
    if cloud_fp == local_fp:
        set_base(title, cloud_fp)
        return
    local_changed = local_fp != base and local_fp != "empty"
    cloud_changed = cloud_fp != base
    if not local_changed:                      # only the cloud moved on (or first time here)
        pull(env, title, g, head, "cloud moved on", local_fp)
        if fingerprint(g["save_paths"]) != cloud_fp:
            log(f"sync {title}: after pull, live fp differs from cloud fp (restore wrote other paths?)")
        set_base(title, cloud_fp)
        pending_file(title).unlink(missing_ok=True)
        return
    if not cloud_changed:                      # only this device moved on (missed push)
        push_now(env, title, g, "missed push", cloud_fp)
        return
    choice, how = ask_conflict(title, head, local_fp, g)
    record_conflict(env, title, "before launch", choice, how, base, local_fp, head, g)
    if choice == "later":
        pending_file(title).write_text("conflict")
        return
    if choice == "cloud":
        pull(env, title, g, head, "conflict: chose cloud", local_fp)
        set_base(title, cloud_fp)
        pending_file(title).unlink(missing_ok=True)
    else:
        push_now(env, title, g, "conflict: chose this device", cloud_fp)


def push_now(env, title, g, why, replaced):
    r = backup([title])
    if r.returncode != 0:
        raise RuntimeError(f"backup failed: {r.stderr.strip()}")
    fp = fingerprint(g["save_paths"])
    push(env, title, g, fp, why, replaced)
    set_base(title, fp)
    pending_file(title).unlink(missing_ok=True)


def sync_after(g, why="after play"):
    """After the game exits (backup already taken): publish if it changed."""
    title = g["title"]
    fp = fingerprint(g["save_paths"])
    base = get_base(title)
    if pending_file(title).exists() and pending_file(title).read_text() == "conflict":
        log(f"sync {title}: unresolved conflict, not pushing (next launch asks again)")
        return
    if fp == base:
        return
    try:
        env = cloud_env()
        if env is None:
            return
        head = cloud_head(env, title)
        if head and head["fp"] not in (base, fp):
            # someone else pushed while we played
            choice, how = ask_conflict(title, head, fp, g)
            record_conflict(env, title, "after play", choice, how, base, fp, head, g)
            if choice == "later":
                pending_file(title).write_text("conflict")
                return
            if choice == "cloud":
                pull(env, title, g, head, "conflict: chose cloud", fp)
                set_base(title, head["fp"])
                pending_file(title).unlink(missing_ok=True)
                return
            why = "conflict: chose this device"
        pending_file(title).write_text("push")  # if we're cut off anyway, the timer finishes it
        push(env, title, g, fp, why, head and head["fp"])
        set_base(title, fp)
        pending_file(title).unlink(missing_ok=True)
    except Offline as e:
        pending_file(title).write_text("push")
        notify(f"{title}: saved locally, not synced", "Offline; it will upload when you're back online.")
        log(f"sync {title}: offline after play ({e}); pending")


REPO = "WiNloSt/save-sync"
SRC = APP_HOME / "src"
UPDATE_EVERY = 10 * 60   # i.e. every 15-min timer tick


def latest_commit(timeout):
    """main's commit sha: one request, a 40-byte answer (0.1-0.4 s). Unauthenticated
    GitHub allows 60/h per IP; launches + 4 timer ticks/h per device stay well under."""
    with urllib.request.urlopen(urllib.request.Request(
            f"https://api.github.com/repos/{REPO}/commits/main",
            headers={"user-agent": "save-sync", "accept": "application/vnd.github.sha"}),
            timeout=timeout) as r:
        latest = r.read().decode().strip()
    STATE.mkdir(parents=True, exist_ok=True)
    (STATE / "update-check").touch()
    return latest if re.fullmatch(r"[0-9a-f]{40}", latest) else None


def installed_commit():
    return (SRC / ".commit").read_text().strip() if (SRC / ".commit").exists() else ""


def install(latest, timeout=900):
    """Download + install that commit (get.sh; 2-4 s so far). True if it worked."""
    log(f"update: {installed_commit()[:7] or '?'} -> {latest[:7]}")
    r = subprocess.run(["sh", "-c", f"curl -fsSL https://raw.githubusercontent.com/{REPO}/{latest}/get.sh | sh"],
                       env={**os.environ, "SAVESYNC_REF": latest, "NONINTERACTIVE": "1"},
                       capture_output=True, text=True, timeout=timeout)
    if r.returncode != 0:
        log(f"update: FAILED: {(r.stderr or r.stdout)[-500:]}")
        return False
    log(f"update: installed {latest[:7]}")
    notify("save-sync updated", f"Now at {latest[:7]}.")
    return True


def check_failed(e, quiet):
    # offline is normal (every timer tick, every offline launch): not worth a log line
    if not (quiet and isinstance(e, urllib.error.URLError) and not isinstance(e, urllib.error.HTTPError)):
        log(f"update: check failed ({e!r})")


def update_before_launch():
    """At every game launch: install a newer version first, so a fix applies to
    this very launch. True if one was installed (the caller re-runs the hook with
    it). Only for an installed copy (src/.commit), never a checkout or a test."""
    if os.environ.get("SAVESYNC_UPDATED") or not installed_commit() \
            or settings().get("auto_update", True) is False:
        return False
    try:
        latest = latest_commit(timeout=3)     # offline: give up fast, don't hold the launch
    except Exception as e:
        check_failed(e, quiet=True)
        return False
    return bool(latest) and latest != installed_commit() and install(latest, timeout=120)


def cmd_update(args=None):
    """Install the latest save-sync from GitHub if it's newer. `--auto`: at most
    every UPDATE_EVERY, quietly, and only if settings allow (the timer calls this;
    game launches check on their own, see update_before_launch)."""
    auto = "--auto" in (args or [])
    stamp = STATE / "update-check"
    if auto:
        if settings().get("auto_update", True) is False:
            return
        if stamp.exists() and time.time() - stamp.stat().st_mtime < UPDATE_EVERY:
            return
    try:
        latest = latest_commit(timeout=15)
    except Exception as e:
        check_failed(e, quiet=auto)
        if not auto:
            say(f"Couldn't check for updates: {e}")
        return
    current = installed_commit()
    if not latest or latest == current:
        if not auto:
            say(f"Up to date ({current[:7] or 'unknown'}).")
        return
    if subprocess.run(["pgrep", "-f", "savesync hook"], capture_output=True).returncode == 0:
        log("update: a game hook is running; will retry later")
        stamp.unlink(missing_ok=True)
        return
    ok = install(latest)
    if not auto:
        say(f"Updated to {latest[:7]}." if ok else "Update failed; see ~/.local/share/save-sync/logs/savesync.log")


def cmd_sync(args):
    """Push anything pending (the flush timer runs this), or sync named games."""
    reg = registry()
    pending_only = "--pending" in args
    names = [a for a in args if not a.startswith("--")]
    for app, g in reg.items():
        if names and app not in names and g["title"] not in names:
            continue
        title = g["title"]
        state = pending_file(title).read_text() if pending_file(title).exists() else None
        if pending_only and state != "push":
            continue
        try:
            if state == "push" or not pending_only:
                sync_after(g, "pending upload") if state == "push" else (sync_before(g), sync_after(g, "manual sync"))
        except Offline as e:
            log(f"sync {title}: still offline ({e})")
        except Exception as e:
            log(f"sync {title}: ERROR {e!r}")
    for f in STATE.glob("*.pending") if STATE.exists() else []:
        say(f"  pending: {f.stem} ({f.read_text()})")


def cmd_resolve(args):
    """Settle a pending conflict without the popup (e.g. it couldn't be shown)."""
    if len(args) != 2 or args[1] not in ("cloud", "local"):
        raise SystemExit("usage: savesync resolve <game> cloud|local")
    g = registry()[find_game(registry(), args[0])]
    os.environ["SAVESYNC_CONFLICT_CHOICE"] = args[1]
    sync_before(g)
    p = pending_file(g["title"])
    say(f"{g['title']}: still pending ({p.read_text()})" if p.exists() else f"{g['title']}: in sync")


def cmd_history(args):
    """The cloud's event log for one game: who pushed / pulled / hit a conflict."""
    n = 30
    if "-n" in args:
        i = args.index("-n")
        n, args = int(args[i + 1]), args[:i] + args[i + 2:]
    if len(args) != 1:
        raise SystemExit("usage: savesync history <game> [-n N]")
    reg = registry()
    try:
        title = reg[find_game(reg, args[0])]["title"]
    except SystemExit:
        title = args[0]                  # a game this device doesn't have
    env = cloud_env()
    if env is None:
        raise SystemExit("cloud sync is not configured")
    names = sorted(x for x in rclone(env, "lsf", f"ss:events/{title}", check=False).stdout.split("\n")
                   if x.endswith(".json"))[-n:]
    tmp = STATE / "history"
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir(parents=True)
    (tmp / "list").write_text("\n".join(names) + "\n")
    if names:
        rclone(env, "copy", "--files-from-raw", str(tmp / "list"), f"ss:events/{title}", str(tmp / "ev"))
    t = lambda x: time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(x)) if x else "?"
    f8 = lambda x: (x or "-")[:8]
    for name in names:
        e = load_json(tmp / "ev" / name, {})
        k = e.get("kind")
        if k == "push":
            what = (f"{f8(e.get('fp'))} on top of {f8(e.get('parent'))}, replacing {f8(e.get('replaced'))}"
                    f"  ({e.get('why')}; session started {t(e.get('session_start'))})")
        elif k == "pull":
            what = (f"{f8(e.get('fp'))} from {e.get('from_device')} (pushed {t(e.get('pushed'))}), "
                    f"replacing {f8(e.get('replaced'))}  ({e.get('why')})")
        elif k == "conflict":
            what = (f"{e.get('when')}: {e.get('choice')} ({e.get('how')})  this device {f8(e.get('local_fp'))}"
                    f" [session {t(e.get('local_session_start'))}] vs cloud {f8(e.get('cloud_fp'))} from "
                    f"{e.get('cloud_device')} [session {t(e.get('cloud_session_start'))}], base {f8(e.get('base'))}")
        else:
            what = json.dumps(e)
        say(f"{t(e.get('time'))}  {e.get('device', '?'):<12} {k:<9} {what}  [{e.get('version')}]")
    if not names:
        say(f"no events for {title} yet (the log starts with this version)")
    head = cloud_head(env, title)
    if head:
        say(f"cloud now: {f8(head['fp'])} from {head.get('device')} at {t(head.get('time'))}")
    shutil.rmtree(tmp, ignore_errors=True)


# ------------------------------------------------------------ hook (Heroic)
def cmd_hook(args):
    if len(args) < 6:
        raise SystemExit("usage: savesync hook before|after <app> <title> <exec> <runner> <prefix>")
    stage, app, title, exe, runner, prefix = args[:6]
    # Closing Heroic (Steam's "Exit game" in Game Mode) SIGTERMs the hook script,
    # and flatpak-spawn forwards that to us: the backup/upload died half-way.
    # Finish regardless (the signal goes to this process only, not rclone/ludusavi).
    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, signal.SIG_IGN)
    try:
        if stage == "before" and update_before_launch():
            # run this launch with the version just installed
            new = str(HOME / ".local/bin/savesync")
            os.execve(new, [new, "hook", *args], {**os.environ, "SAVESYNC_UPDATED": "1"})
    except Exception as e:  # an update problem never blocks the game
        log(f"update: at launch: {e!r}")
    try:
        (hook_before if stage == "before" else hook_after)(app, title, exe, runner, prefix)
    except Exception as e:  # never break a game launch
        log(f"hook {stage} {app}: ERROR {e!r}")
        notify(f"{title}: save-sync error", str(e))


def hook_before(app, title, exe, runner, prefix):
    reg = registry()
    g = reg.get(app)
    if g is None:
        if runner != "sideload":
            log(f"before {app}: runner {runner} not handled yet, skipped")
            return
        g = {"title": title, "runner": runner, "exec": exe, "prefix": prefix,
             "game_dir": str(Path(exe).parent) if exe else None,
             "save_paths": [], "confirmed": False, "added": time.strftime("%Y-%m-%d")}
        g["save_paths"] = rule_paths(g)
        reg[app] = g
        save_json(REGISTRY, reg)
        cmd_gen_config(quiet=True)
        log(f"before {app}: new game '{title}', rule paths {g['save_paths']}")
    else:
        old_dir = g.get("game_dir")
        new_dir = str(Path(exe).parent) if exe else old_dir
        g.update({"title": title, "exec": exe, "prefix": prefix, "game_dir": new_dir})
        if g.get("engine") == "renpy" and not g.get("confirmed"):
            g["save_paths"] = rule_paths(g)
        if old_dir and new_dir != old_dir:
            # Game updated to a new folder (SpiderMan-1.0-pc -> SpiderMan-1.1-pc): save
            # folders inside the old game folder move with it.
            g["save_paths"] = [new_dir + p[len(old_dir):] if p == old_dir or p.startswith(old_dir + "/")
                               else p for p in g.get("save_paths", [])]
            log(f"before {app}: game moved {old_dir} -> {new_dir}, save paths follow")
            cmd_gen_config(quiet=True)
        save_json(REGISTRY, reg)
    sync_before(g)
    if g.get("save_paths"):
        start_session(g)
    # Remember the state so the after-hook can tell which folders the game
    # wrote to (until the save folders are confirmed).
    if not g.get("confirmed") and not g.get("engine"):
        STATE.mkdir(parents=True, exist_ok=True)
        snap = walk_mtimes(WATCH_ROOTS, watch_roots_for(g))
        save_json(STATE / f"{app}.snap.json", {"started": time.time(), "files": snap})
    log(f"before {app}: ok")


def hook_after(app, title, exe, runner, prefix):
    reg = registry()
    g = reg.get(app)
    if g is None:
        log(f"after {app}: not registered, skipped")
        return
    snap_file = STATE / f"{app}.snap.json"
    if not g.get("confirmed") and snap_file.exists():
        snap = load_json(snap_file, {})
        roots = [*WATCH_ROOTS, *watch_roots_for(g)]
        after = walk_mtimes(WATCH_ROOTS, watch_roots_for(g))
        found = changed_dirs(snap.get("files", {}), after, snap.get("started", time.time()),
                             roots, g.get("game_dir"))
        snap_file.unlink(missing_ok=True)
        new = [d for d in found if d not in g.get("save_paths", [])]
        g["suggested_paths"] = new
        save_json(REGISTRY, reg)
        log(f"after {app}: suggested save folders (NOT backed up until confirmed): {new}")
        if new:
            notify(f"{title}: where does it save?",
                   "Suggested (not backed up yet):\n" + "\n".join(new) +
                   f"\nPick: savesync paths '{app}' --add <folder>   (or --set)")
        elif not g.get("save_paths"):
            notify(f"{title}: no save folder found", f"Set it: savesync paths '{app}' --set <folder>")
    if not g.get("save_paths"):
        return
    r = backup([g["title"]])
    if r.returncode != 0:
        notify(f"{title}: save backup FAILED", "See ~/.local/share/save-sync/logs/savesync.log")
        return
    log(f"after {app}: backup ok")
    sync_after(g)


# ------------------------------------------------------------ user commands
def cmd_list(_args=None):
    reg = registry()
    if not reg:
        say("No games yet. Launch a game from Heroic once and it shows up here.")
        return
    for app, g in sorted(reg.items(), key=lambda x: x[1]["title"].lower()):
        mark = "confirmed" if g.get("confirmed") else "NOT confirmed"
        say(f"{g['title']}  [{app}]  ({mark})")
        for p in g.get("save_paths") or ["(no save folder yet)"]:
            exists = "" if p.startswith("(") or Path(p).exists() else "  (missing)"
            say(f"    {p}{exists}")
        for p in g.get("suggested_paths", []):
            say(f"    suggested, not backed up: {p}")


def cmd_paths(args):
    if not args:
        raise SystemExit("usage: savesync paths <game> [--set P… | --add P | --detect]")
    reg = registry()
    app = find_game(reg, args[0])
    g = reg[app]
    rest = args[1:]
    if not rest:
        cmd_list_one(g, app)
        return
    if rest[0] == "--set" and rest[1:]:
        g["save_paths"] = [str(Path(os.path.expanduser(p)).resolve()) for p in rest[1:]]
        g["confirmed"] = True
    elif rest[0] == "--add" and len(rest) == 2:
        g["save_paths"] = g.get("save_paths", []) + [str(Path(os.path.expanduser(rest[1])).resolve())]
        g["confirmed"] = True
    elif rest[0] == "--detect":
        g["save_paths"] = rule_paths(g)
        g.pop("suggested_paths", None)
        g["confirmed"] = False   # watch the next play session again (if no engine rule)
    elif rest[0] == "--confirm":
        sug = g.get("suggested_paths", [])
        if len(sug) > 1:
            say("  More than one suggestion. Other apps may have written there too, so pick the right one(s):")
            for d in sug:
                say(f"    savesync paths '{app}' --add '{d}'")
            return
        for d in g.pop("suggested_paths", []):
            n, size = dir_size(d)
            if n > MAX_SUGGEST_FILES or size > MAX_SUGGEST_BYTES:
                say(f"  skipped {d}: too big to be a save folder ({n}+ files, {size >> 20}+ MB)")
            elif d not in g.get("save_paths", []):
                g.setdefault("save_paths", []).append(d)
        g["confirmed"] = True
    else:
        raise SystemExit("usage: savesync paths <game> [--set P… | --add P | --detect | --confirm]")
    missing = [p for p in g["save_paths"] if not Path(p).exists()]
    save_json(REGISTRY, reg)
    cmd_gen_config(quiet=True)
    cmd_list_one(g, app)
    if missing:
        say(f"  note: doesn't exist (yet): {', '.join(missing)}")


def cmd_list_one(g, app):
    say(f"{g['title']}  [{app}]  ({'confirmed' if g.get('confirmed') else 'NOT confirmed'})")
    for p in g.get("save_paths", []):
        say(f"    {p}")


def cmd_backup(args):
    reg = registry()
    titles = [reg[find_game(reg, a)]["title"] for a in args] if args else \
             [g["title"] for g in reg.values() if g.get("save_paths")]
    r = backup(titles)
    say(r.stdout.strip()[-1500:] if r.stdout else "")
    if r.returncode != 0:
        raise SystemExit(f"backup failed: {r.stderr.strip()}")


# ------------------------------------------------------------ Heroic setup
def heroic_running():
    # pgrep -f would also match any shell whose command line mentions the id
    r = subprocess.run(["flatpak", "ps", "--columns=application"], capture_output=True, text=True)
    return HEROIC_APP in r.stdout.split()


def hook_script():
    savesync = HOME / ".local/bin/savesync"
    return f"""#!/bin/sh
# Generated by save-sync. Heroic runs this before and after every game
# (Settings → Games → Scripts). The work happens on the host.
exec flatpak-spawn --host {savesync} hook "$HEROIC_GAME_SCRIPT_STAGE" \\
  "$HEROIC_GAME_APP_NAME" "$HEROIC_GAME_TITLE" "$HEROIC_GAME_EXEC" \\
  "$HEROIC_GAME_RUNNER" "$HEROIC_GAME_PREFIX"
"""


def cmd_setup_heroic(_args=None):
    HOOK_DIR.mkdir(parents=True, exist_ok=True)
    HOOK.write_text(hook_script())
    HOOK.chmod(0o755)
    if heroic_running():
        raise SystemExit("Heroic is running; it rewrites its config on exit. Quit Heroic and re-run.")
    cfg = load_json(HEROIC_CONFIG, None)
    if cfg is None:
        raise SystemExit(f"Heroic config not found at {HEROIC_CONFIG}. Start Heroic once, quit, re-run.")
    shutil.copyfile(HEROIC_CONFIG, HEROIC_CONFIG.with_suffix(".json.save-sync.bak"))
    d = cfg.setdefault("defaultSettings", {})
    for key in ("beforeLaunchScriptPath", "afterLaunchScriptPath"):
        cur = d.get(key) or ""
        if cur and cur != str(HOOK):
            say(f"  ! Heroic already has a global {key}: {cur}. Left alone; save-sync is NOT hooked.")
            continue
        d[key] = str(HOOK)
    save_json(HEROIC_CONFIG, cfg)
    say(f"  Heroic global Before/After launch scripts → {HOOK}")
    # A game's own settings file snapshots every global value once you change
    # any of its settings; an empty script path there would bypass the hook.
    for f in sorted(HEROIC_GAMESCONFIG.glob("*.json")):
        data = load_json(f, {})
        changed = False
        for app, s in data.items():
            if not isinstance(s, dict):
                continue
            for key in ("beforeLaunchScriptPath", "afterLaunchScriptPath"):
                if key in s and s[key] == "":
                    s[key] = str(HOOK)
                    changed = True
        if changed:
            save_json(f, data)
            say(f"  patched per-game hook in {f.name}")
    migrate_phase1()


def migrate_phase1():
    """Phase-1 builds sideloaded games as ~/Games/Heroic/save-sync/<slug>.sh
    launchers keyed by slug. Point them at the real game and key by app name."""
    reg = registry()
    old = {k: v for k, v in reg.items() if "dir_pattern" in v}
    if not old:
        return
    lib = load_json(HEROIC_LIBRARY, {"games": []})
    shutil.copyfile(HEROIC_LIBRARY, HEROIC_LIBRARY.with_suffix(".json.save-sync.bak"))
    for slug, g in old.items():
        root = Path(os.path.expanduser(g["root"]))
        dirs = sorted((Path(p) for p in glob.glob(str(root / g["dir_pattern"])) if Path(p).is_dir()),
                      key=lambda p: [int(n) for n in re.findall(r"\d+", p.name)])
        app = "savesync-" + slug
        del reg[slug]
        if not dirs:
            say(f"  ! {g['title']}: game folder not found, dropped")
            continue
        d = dirs[-1]
        exe = d / g["launcher"]
        new = {"title": g["title"], "runner": "sideload", "exec": str(exe), "prefix": "",
               "game_dir": str(d), "renpy_dir": g.get("renpy_dir"), "save_paths": [],
               "confirmed": False, "added": time.strftime("%Y-%m-%d")}
        new["save_paths"] = rule_paths(new)
        reg[app] = new
        for e in lib.get("games", []):
            if e.get("app_name") == app:
                e["install"]["executable"] = str(exe)
                e["folder_name"] = str(d)
        say(f"  migrated {g['title']} → Heroic runs {exe} directly")
    save_json(HEROIC_LIBRARY, lib)
    save_json(REGISTRY, reg)
    for p in HOOK_DIR.glob("*.sh"):
        if p != HOOK:
            p.unlink()
    cmd_gen_config(quiet=True)


def cmd_unhook_heroic(_args=None):
    if heroic_running():
        raise SystemExit("Quit Heroic first.")
    cfg = load_json(HEROIC_CONFIG, {})
    d = cfg.get("defaultSettings", {})
    for key in ("beforeLaunchScriptPath", "afterLaunchScriptPath"):
        if d.get(key) == str(HOOK):
            d[key] = ""
    save_json(HEROIC_CONFIG, cfg)
    for f in HEROIC_GAMESCONFIG.glob("*.json"):
        data = load_json(f, {})
        for s in data.values():
            if isinstance(s, dict):
                for key in ("beforeLaunchScriptPath", "afterLaunchScriptPath"):
                    if s.get(key) == str(HOOK):
                        s[key] = ""
        save_json(f, data)
    shutil.rmtree(HOOK_DIR, ignore_errors=True)
    say("  Heroic hooks removed")


# ------------------------------------------------------------ doctor
def cmd_doctor(_args=None):
    problems = 0

    def check(ok_, msg, fix=""):
        nonlocal problems
        print(f"  [{'✓' if ok_ else 'x'}] {msg}" + ("" if ok_ else f"  → {fix}"))
        problems += 0 if ok_ else 1

    check(LUDUSAVI.exists() and os.access(LUDUSAVI, os.X_OK), f"ludusavi at {LUDUSAVI}", "./install.sh")
    check((APP_HOME / "bin/rclone").exists(), "rclone installed (for the cloud phase)", "./install.sh")
    check((HOME / ".local/bin/savesync").exists(), "savesync on PATH (~/.local/bin)", "./install.sh")
    check((LUDUSAVI_CFG / "config.yaml").exists() and ludusavi("config", "show").returncode == 0,
          "Ludusavi config valid", "savesync gen-config")
    ov = subprocess.run(["flatpak", "override", "--user", "--show", HEROIC_APP],
                        capture_output=True, text=True).stdout
    check("org.freedesktop.Flatpak=talk" in ov, "Heroic hooks can reach the host", "./install.sh")
    check("~/games" in ov and "~/.renpy" in ov, "Heroic can see ~/games and ~/.renpy", "./install.sh")
    check(HOOK.exists(), f"hook script {HOOK}", "savesync setup-heroic")
    d = load_json(HEROIC_CONFIG, {}).get("defaultSettings", {})
    check(d.get("beforeLaunchScriptPath") == str(HOOK) and d.get("afterLaunchScriptPath") == str(HOOK),
          "Heroic global Before/After scripts point at save-sync", "quit Heroic, savesync setup-heroic")
    for f in sorted(HEROIC_GAMESCONFIG.glob("*.json")):
        for app, s in load_json(f, {}).items():
            if isinstance(s, dict):
                for key in ("beforeLaunchScriptPath", "afterLaunchScriptPath"):
                    if key in s and s[key] != str(HOOK):
                        check(False, f"{app}: per-game {key} bypasses save-sync ({s[key]!r})",
                              "quit Heroic, savesync setup-heroic")
    reg = registry()
    for app, g in sorted(reg.items()):
        paths = g.get("save_paths", [])
        check(bool(paths) and all(Path(p).exists() for p in paths),
              f"{g['title']}: {len(paths)} save folder(s)", f"savesync paths '{app}' --set <folder>")
        if not g.get("confirmed"):
            print(f"  [ ] {g['title']}: save folders not confirmed yet (savesync paths '{app}' --confirm)")
    for f in sorted(STATE.glob("*.pending")) if STATE.exists() else []:
        if f.read_text() == "conflict":
            check(False, f"{f.stem}: unresolved save conflict", f"savesync resolve '{f.stem}' cloud|local")
    print("  all good" if problems == 0 else f"  {problems} problem(s)")
    return problems == 0


COMMANDS = {
    "list": cmd_list, "paths": cmd_paths, "backup": cmd_backup,
    "setup-heroic": cmd_setup_heroic, "unhook-heroic": cmd_unhook_heroic,
    "gen-config": cmd_gen_config, "doctor": cmd_doctor, "hook": cmd_hook, "sync": cmd_sync,
    "login": cmd_login, "devices": cmd_devices, "status": cmd_status, "update": cmd_update,
    "resolve": cmd_resolve, "history": cmd_history,
}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        print(__doc__)
        sys.exit(2)
    res = COMMANDS[sys.argv[1]](sys.argv[2:])
    if sys.argv[1] == "doctor" and res is False:
        sys.exit(1)
